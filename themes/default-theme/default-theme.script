Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

# Spinner ring below the logo, redrawn rotated each frame
spinner.image = Image("spinner.png");
spinner.sprite = Sprite();
spinner.sprite.SetPosition(
  Window.GetX() + Window.GetWidth()  / 2 - spinner.image.GetWidth()  / 2,
  Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 60,
  10);
spinner.angle = 0;

fun spinner_refresh_callback() {
  spinner.angle = (spinner.angle + 8) % 360;
  spinner.sprite.SetImage(spinner.image.Rotate(spinner.angle * 3.14159265 / 180));
}
Plymouth.SetRefreshFunction(spinner_refresh_callback);
